{
  "name": "semantic-dom-sentinel",
  "version": "0.1.1",
  "description": "A framework-agnostic, local-only DOM integrity monitor with deterministic alerts.",
  "keywords": [
    "dom",
    "dom-monitoring",
    "mutation-observer",
    "browser",
    "typescript",
    "integrity-monitoring"
  ],
  "homepage": "https://github.com/GuardrailEngine/semantic-dom-sentinel#readme",
  "bugs": {
    "url": "https://github.com/GuardrailEngine/semantic-dom-sentinel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuardrailEngine/semantic-dom-sentinel.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:perf": "vitest run tests/performance",
    "test:e2e": "npm run build && playwright test",
    "test:package": "npm run build && node scripts/test-package-consumer.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:e2e && npm run test:package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
